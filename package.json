{
  "name": "windcloud-client",
  "version": "0.3.3",
  "private": true,
  "description": "風雲再起跨平台 Telnet 客戶端，提供 zMUD 風格 Trigger 與 Alias",
  "author": "Windcloud Client contributors",
  "license": "MIT",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "iconv-lite": "^0.6.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@xterm/headless": "5.5.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "me.muds.windcloud.client",
    "productName": "Windcloud Client",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "packageManager": "pnpm@11.25.0"
}
