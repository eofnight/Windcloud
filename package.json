{
  "name": "windcloud-client",
  "version": "0.3.8+1",
  "private": true,
  "description": "風雲再起跨平台 Telnet 客戶端，提供 zMUD 風格 Trigger 與 Alias",
  "author": "Windcloud Client contributors",
  "license": "MIT",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "iconv-lite": "^0.6.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@xterm/headless": "5.5.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "me.muds.windcloud.client",
    "productName": "Windcloud Client",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "timestamp": "none",
      "artifactName": "${productName}-0.3.8.1-${arch}.${ext}",
      "bundleShortVersion": "0.3.8"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}.Setup.0.3.8.1.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterSign": "scripts/verify-mac-signature.cjs",
    "afterPack": "scripts/clean-mac-metadata.cjs",
    "buildVersion": "0.3.8.1",
    "buildNumber": "1"
  },
  "packageManager": "pnpm@11.25.0"
}
